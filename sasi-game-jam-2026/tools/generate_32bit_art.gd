func desk(x: int, y: int, monitor: bool) -> void:
	rect(x+3,y+16,5,12,INK)
	rect(x+59,y+16,5,12,INK)
	rect(x,y,68,18,INK)
	for row in 3:
		timber(x+1,y+1+row*5,66,5)
	if monitor:
