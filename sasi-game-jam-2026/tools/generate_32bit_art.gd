extends SceneTree
## T-012. Atlas nativos, um caractere por pixel. O ponto representa RGBA zero.
const DEST := "res://assets/sprites/"
const INK := "#181224"
var art: Image
var rng := RandomNumberGenerator.new()
var failed := false

func _initialize() -> void:
	rng.seed = 12026
	if DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(DEST)) != OK:
		push_error("Falha ao criar " + DEST)
		quit(1)
		return
	arena()
	save("arena_bg")
	sheet("seu_antonio_sheet", SEU_ANTONIO_SHEET)
	sheet("care_core_sheet", CARE_CORE_SHEET)
	sheet("allies_sheet", ALLIES_SHEET)
	sheet("enemy_routine_sheet", ENEMY_ROUTINE_SHEET)
	sheet("enemy_fatigue_sheet", ENEMY_FATIGUE_SHEET)
	sheet("enemy_grief_sheet", ENEMY_GRIEF_SHEET)
	sheet("enemy_boss_sheet", ENEMY_BOSS_SHEET)
	quit(1 if failed else 0)

func save(asset: String) -> void:
	var path := DEST + asset + ".png"
	if art.save_png(path) != OK:
		push_error("Falha ao salvar " + path)
		failed = true
	else:
		print(asset, " ", art.get_size())

func stamp(data: Array) -> Image:
	var rows: PackedStringArray = data[2].split("\n")
	var hexes: PackedStringArray = data[1].split(" ")
	var colors := {}
	for i in hexes.size():
		colors[data[0][i]] = Color(hexes[i])
	var result := Image.create_empty(rows[0].length(), rows.size(), false, Image.FORMAT_RGBA8)
	for y in rows.size():
		for x in rows[y].length():
			var symbol := rows[y][x]
			if symbol != ".":
				result.set_pixel(x, y, colors[symbol])
	return result

func sheet(asset: String, data: Array) -> void:
	art = stamp(data)
	save(asset)

func rect(x: int, y: int, w: int, h: int, color: String) -> void:
	var area := Rect2i(x,y,w,h).intersection(Rect2i(0,0,640,360))
	if area.has_area():
		art.fill_rect(area, Color(color))

func prop(data: Array, x: int, y: int) -> void:
	var bitmap := stamp(data)
	art.blend_rect(bitmap, Rect2i(Vector2i.ZERO, bitmap.get_size()), Vector2i(x,y))

func timber(x: int, y: int, w: int, h: int) -> void:
	rect(x,y,w,h,"472e26")
	rect(x+1,y,w-2,h-2,"5b3d31")
	rect(x+2,y,w-4,1,"704c3b")
	for i in maxi(1,w/8):
		rect(x+rng.randi_range(2,w-7),y+rng.randi_range(1,h-2),rng.randi_range(2,5),1,"4e342e")
	rect(x+2,y+2,1,1,"292330")
	rect(x+w-3,y+2,1,1,"322831")

func masonry(x: int, y: int, w: int, h: int, cap: bool) -> void:
	var palette := ["4b3842","573d43","604348","67494a"]
	for row in range(0,h,5):
		for col in range(-14,w,14):
			var start := col + (7 if row % 2 else 0)
			var left := maxi(start,0)
			var width := mini(w,start+13)-left
			if width < 2:
				continue
			rect(x+left,y+row,width,mini(4,h-row),palette[rng.randi_range(0,3)])
			rect(x+left+1,y+row,width-2,1,"805c55")
	if cap:
		for i in range(0,w,17):
			rect(x+i,y,mini(16,w-i),3,"67616a")
			rect(x+i+1,y,mini(13,w-i-1),1,"938579")

func window(x: int) -> void:
	rect(x-3,9,46,23,INK)
	timber(x-2,10,44,19)
	for pane in 4:
		var px := x+3+(pane%2)*18
		var py := 12+(pane/2)*7
		rect(px,py,15,6,"ac7148")
		rect(px+1,py+1,13,5,"de9f5c")
		rect(px+2,py+2,5,4,"f1bf71")
		for j in 4:
			rect(px+13-j,py+j,2,1,"eeb573")
	timber(x-4,28,48,4)

func arena() -> void:
	art = Image.create_empty(640,360,false,Image.FORMAT_RGBA8)
	art.fill(Color("1a1f2c"))
	var shale := ["2a3346","30394d","323e54","2c374b","293245","283344","303a4e"]
	for y in range(0,360,9):
		var x := -rng.randi_range(0,20)
		while x<640:
			var w := rng.randi_range(13,27)
			rect(x+1,y+1,w-2,7,shale[rng.randi_range(0,shale.size()-1)])
			rect(x+2,y,w-5,1,"394558")
			rect(x+2,y+7,w-4,1,"232b3c")
			rect(x+3,y+2,rng.randi_range(2,7),1,"354155")
			if rng.randf()<0.20:
				for i in 4:
					rect(x+5+i,y+3+i/2,1,1,"222c3e")
			if rng.randf()<0.16:
				for i in 6:
					rect(x+rng.randi_range(0,6),y+rng.randi_range(6,8),2,1,"35483e" if i%2 else "293e38")
			x+=w
	for y in range(32,181,7):
		timber(300+rng.randi_range(-1,1),y,40,7)
	for y in range(144,217):
		for x in range(284,357):
			var dx := x-320
			var dy := y-180
			var radius := sqrt(float(dx*dx+dy*dy))
			if radius>35:
				continue
			var angle := atan2(float(dy),float(dx))
			var tone := "424450"
			if radius>33 or (radius>26 and radius<28):
				tone="847156"
			elif radius>28:
				tone="534e4c" if cos(angle*24)>0.93 else "675e52"
			elif radius<7 or absf(dx)+absf(dy)<17 or (abs(dx)==abs(dy) and radius<23):
				tone="998564"
			elif absf(radius-(16+6*cos(angle*8)))<1.2:
				tone="776b56"
			elif (x+y)%4==0:
				tone="484954"
			art.set_pixel(x,y,Color(tone))
	for i in 12:
		var a := TAU*i/12
		var x := 320+roundi(30*cos(a))
		var y := 180+roundi(30*sin(a))
		rect(x-1,y-1,1,3,"b09a70")
		rect(x,y,2,1,"9d8666")
	# Fachada, beiral de telhas sobrepostas e soleira.
	rect(0,0,640,37,"2b242c")
	masonry(0,8,640,23,false)
	for x in range(0,640,52):
		rect(x,8,4,25,"462f2e")
		rect(x,8,1,24,"90664b")
	for row in 2:
		for x in range(-12,640,12):
			var px := x+row*6
			rect(px, row*4,11,5,"703e45")
			rect(px+1,row*4,8,2,"91564f")
			rect(px+2,row*4+4,8,1,"422d38")
	window(202)
	window(398)
	rect(302,7,36,27,INK)
	for x in range(305,336,6):
		rect(x,9,5,23,"694739")
		rect(x,10,1,20,"80583d")
	rect(307,12,24,3,"936647")
	rect(309,18,6,9,"50332f")
	rect(321,18,6,9,"50332f")
	rect(329,22,2,2,"edb86b")
	timber(298,32,44,4)
	for x in [0,626]:
		rect(x,34,14,314,"342b36")
		masonry(x,34,14,314,false)
		for y in range(34,348,14):
			rect(x+3,y,7,13,"625c63")
			rect(x+3,y,2,12,"84787a")
		rect(14 if x==0 else 623,37,3,310,"222938")
	rect(0,347,640,13,"342b36")
	masonry(0,347,640,13,true)
	for i in 50:
		var x := [9,629][i%2] as int
		var y := 42+(i/2)*12
		for j in 8:
			var offset := roundi(3*sin((y+j)*0.16))
			rect(x+offset,y+j,1,2,"3e5141")
			if j%3==0:
				rect(x+offset+(1 if j%2 else -3),y+j,3,2,"526447")
	for x in [22,600]:
		for y in [40,309]:
			prop(LANTERN,x,y)
	for x in [43,561]:
		prop(FLOWERPOT,x,38)
		prop(FLOWERPOT,x,312)
	for x in [88,516]:
		prop(BENCH,x,40)
	prop(WATERING_CAN,74,49)

