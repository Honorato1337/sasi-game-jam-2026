	happy.set_pixel(16, 11, Color("#ee8a84"))
	happy.set_pixel(12, 12, Color("#b8585e"))
	happy.set_pixel(13, 12, Color("#faf0dd"))
	happy.set_pixel(14, 12, Color("#b8585e"))
