	rect(x,y,w,h,"945e56")
	rect(x+2,y+2,w-4,h-4,"3c3042")
	rect(x+4,y+4,w-8,h-8,"744b54")
	rect(x+7,y+7,w-14,h-14,"5f3d49")
	for corner: Vector2i in [
		Vector2i(x+8, y+8), Vector2i(x+w-14, y+8),
		Vector2i(x+8, y+h-14), Vector2i(x+w-14, y+h-14),
	]:
