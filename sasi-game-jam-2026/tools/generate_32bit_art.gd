extends SceneTree
## Três Turnos. Atlas nativos, um caractere por pixel. O ponto representa RGBA zero.
const DEST := "res://assets/sprites/"
const INK := "#181224"
var art: Image
var rng := RandomNumberGenerator.new()
var failed := false

func _initialize() -> void:
	rng.seed = 12026
	if DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(DEST)) != OK:
		push_error("Falha ao criar " + DEST)
		quit(1)
		return
	if "--legacy" in OS.get_cmdline_user_args():
		generate_legacy()
		quit(1 if failed else 0)
		return
	if "--title-only" in OS.get_cmdline_user_args():
		draw_title_screen()
		save("title_bg")
		quit(1 if failed else 0)
		return
	sheet("student_sheet", STUDENT)
	sheet("classmate_sheet", CLASSMATE)
	sheet("stations_sheet", STATIONS)
	sheet("enemy_procrastination_sheet", ENEMY_PROCRASTINATION)
	sheet("enemy_deadline_sheet", ENEMY_DEADLINE)
	sheet("enemy_selfcriticism_sheet", ENEMY_SELFCRITICISM)
	sheet("boss_burnout_sheet", BOSS_BURNOUT)
	for shift in 3:
		draw_room(shift)
		save(["room_morning", "room_afternoon", "room_night"][shift])
	draw_title_screen()
	save("title_bg")
	quit(1 if failed else 0)

func save(asset: String) -> void:
	var path := DEST + asset + ".png"
	if art.save_png(path) != OK:
		push_error("Falha ao salvar " + path)
		failed = true
	else:
		print(asset, " ", art.get_size())

func stamp(data: Array) -> Image:
	var rows: PackedStringArray = data[2].replace("\r", "").split("\n")
	var hexes: PackedStringArray = data[1].split(" ")
	var colors := {}
	for i in hexes.size():
		colors[data[0][i]] = Color(hexes[i])
	var result := Image.create_empty(rows[0].length(), rows.size(), false, Image.FORMAT_RGBA8)
	for y in rows.size():
		for x in rows[y].length():
			var symbol := rows[y][x]
			if symbol != ".":
				result.set_pixel(x, y, colors[symbol])
	return result

func sheet(asset: String, data: Array) -> void:
	art = stamp(data)
	save(asset)

func rect(x: int, y: int, w: int, h: int, color: String) -> void:
	var area := Rect2i(x,y,w,h).intersection(Rect2i(0,0,640,360))
	if area.has_area():
		art.fill_rect(area, Color(color))

func prop(data: Array, x: int, y: int) -> void:
	var bitmap := stamp(data)
	art.blend_rect(bitmap, Rect2i(Vector2i.ZERO, bitmap.get_size()), Vector2i(x,y))

func timber(x: int, y: int, w: int, h: int) -> void:
	rect(x,y,w,h,"472e26")
	rect(x+1,y,w-2,h-2,"5b3d31")
	rect(x+2,y,w-4,1,"704c3b")
	for i in maxi(1,w/8):
		rect(x+rng.randi_range(2,w-7),y+rng.randi_range(1,h-2),rng.randi_range(2,5),1,"4e342e")
	rect(x+2,y+2,1,1,"292330")
	rect(x+w-3,y+2,1,1,"322831")

func masonry(x: int, y: int, w: int, h: int, cap: bool) -> void:
	var palette := ["4b3842","573d43","604348","67494a"]
	for row in range(0,h,5):
		for col in range(-14,w,14):
			var start := col + (7 if row % 2 else 0)
			var left := maxi(start,0)
			var width := mini(w,start+13)-left
			if width < 2:
				continue
			rect(x+left,y+row,width,mini(4,h-row),palette[rng.randi_range(0,3)])
			rect(x+left+1,y+row,width-2,1,"805c55")
	if cap:
		for i in range(0,w,17):
			rect(x+i,y,mini(16,w-i),3,"67616a")
			rect(x+i+1,y,mini(13,w-i-1),1,"938579")

func window(x: int) -> void:
	rect(x-3,9,46,23,INK)
	timber(x-2,10,44,19)
	for pane in 4:
		var px := x+3+(pane%2)*18
		var py := 12+(pane/2)*7
		rect(px,py,15,6,"ac7148")
		rect(px+1,py+1,13,5,"de9f5c")
		rect(px+2,py+2,5,4,"f1bf71")
		for j in 4:
			rect(px+13-j,py+j,2,1,"eeb573")
	timber(x-4,28,48,4)



